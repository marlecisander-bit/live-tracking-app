# Static frontend uses frontend/js/shared/app-config.js; no build-time secrets.
# Optional local-only tooling:
PORT=4199
BROWSER_CHANNEL=chrome
# Hosted Edge Function variable NAMES only, not populated or deployed here:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# TRACKING_PROCESSOR_SECRET
# CENTRAL_PROCESSING_ENABLED
# SCORPION_TOKEN_<binding identifier>
